# dependencies
node_modules/

# testing
coverage/

# misc
.DS_Store
*.pem
*.tsbuildinfo

# debug
npm-debug.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# Spotcraft export (pnpm cms:export), a local backup of the content
spotcraft-content/
