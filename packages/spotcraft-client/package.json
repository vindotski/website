{
	"name": "@spotcraft/client",
	"version": "0.1.0",
	"private": true,
	"description": "Typed client for Spotcraft's public API: documents, search, images, and helpers for headings, webhooks and sign-in. Vendored from Spotcraft's main branch (see SPOTCRAFT_VERSION).",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"sideEffects": false,
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepare": "pnpm build"
	},
	"dependencies": {
		"@types/mdast": "4.0.4",
		"github-slugger": "2.0.0",
		"jose": "6.2.14"
	},
	"devDependencies": {
		"@types/node": "^22.10.2",
		"typescript": "^6.0.2"
	},
	"engines": {
		"node": ">=20"
	}
}
