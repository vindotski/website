# Copy to .env.local. These are the local stack's values (`supabase status`);
# production uses https://api.vin.ski (the custom domain, not <ref>.supabase.co)
# and the hosted project's publishable key, set in Vercel
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Server-only: search and the sync script. Never prefix with NEXT_PUBLIC_.
# Production uses the hosted project's secret key, set in Vercel and in CI
SUPABASE_SECRET_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz

# Google Analytics 4 measurement ID (G-…). Set in Vercel Production only:
# analytics runs only when this is set and the build is production
NEXT_PUBLIC_GA_ID=
