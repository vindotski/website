{
  "name": "vindotski",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter website dev",
    "build": "pnpm --filter website build",
    "start": "pnpm --filter website start",
    "lint": "pnpm --filter website lint",
    "content:check": "node --conditions=source ../spotcraft-main/packages/spotcraft/src/index.ts check content",
    "content:import": "node --conditions=source ../spotcraft-main/packages/spotcraft/src/index.ts import content --project vindotski --name vin.ski",
    "content:export": "node --conditions=source ../spotcraft-main/packages/spotcraft/src/index.ts export content --project vindotski --force",
    "docs:check": "node --conditions=source ../spotcraft-main/bin/check-docs.ts docs"
  },
  "packageManager": "pnpm@12.4.1"
}
