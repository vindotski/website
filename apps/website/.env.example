# Copy to .env.local. These are the local stack's values (`supabase status`);
# production uses https://api.vin.ski (the custom domain, not <ref>.supabase.co)
# and the hosted project's publishable key, set in Vercel
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Cloudflare Turnstile on the login form. This is Cloudflare's always-pass
# test site key; production uses the real one, set in Vercel. The matching
# test secret goes in supabase/.env as
# SUPABASE_AUTH_CAPTCHA_SECRET=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Spotcraft (apps/dashboard), where the content lives. The site's URL
# (production: https://cms.vin.ski/vinski, or without /vinski if it's the
# default site), then SPOTCRAFT_API_TOKEN and WEBHOOK_SECRET from
# apps/dashboard/.env. Server-only: never prefix with NEXT_PUBLIC_
SPOTCRAFT_URL=http://localhost:3000/vinski
SPOTCRAFT_API_TOKEN=
SPOTCRAFT_WEBHOOK_SECRET=
