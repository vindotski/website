# Copy to .env.local.

# Spotcraft's API, where the content is read from (the vindotski project).
# Reads are open, so there's no key. Optional: defaults to https://api.vin.ski
# SPOTCRAFT_API_URL=https://api.vin.ski

# The old Spotcraft (apps/dashboard), for search until it's removed (the
# demo's step 4): the site's URL (production: https://cms.vin.ski/vinski),
# then SPOTCRAFT_API_TOKEN from apps/dashboard/.env. Server-only: never prefix
# with NEXT_PUBLIC_
SPOTCRAFT_URL=http://localhost:3000/vinski
SPOTCRAFT_API_TOKEN=
