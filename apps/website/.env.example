# Copy to .env.local.

# Spotcraft (apps/dashboard), where the content lives. The site's URL
# (production: https://cms.vin.ski/vinski, or without /vinski if it's the
# default site), then SPOTCRAFT_API_TOKEN and WEBHOOK_SECRET from
# apps/dashboard/.env. Server-only: never prefix with NEXT_PUBLIC_
SPOTCRAFT_URL=http://localhost:3000/vinski
SPOTCRAFT_API_TOKEN=
SPOTCRAFT_WEBHOOK_SECRET=
