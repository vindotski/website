      "policies": {},
      "checkConstraints": {
        "entries_kind": {
          "name": "entries_kind",
          "value": "\"entries\".\"kind\" in ('folder', 'document', 'image')"
        },
        "entries_root": {
          "name": "entries_root",
          "value": "(\"entries\".\"parent\" is null) = (\"entries\".\"path\" = '') and (\"entries\".\"parent\" is not null or (\"entries\".\"kind\" = 'folder' and \"entries\".\"slug\" = ''))"
        },
        "entries_parent_kind": {
          "name": "entries_parent_kind",
          "value": "\"entries\".\"parent\" is null\n\t\t\t\tor (\"entries\".\"kind\" = 'document' and \"entries\".\"parent_kind\" = 'folder')\n\t\t\t\tor (\"entries\".\"kind\" in ('folder', 'image') and \"entries\".\"parent_kind\" in ('folder', 'document'))"
        },
        "entries_slug_format": {
          "name": "entries_slug_format",
          "value": "\"entries\".\"path\" = ''\n\t\t\t\tor (\"entries\".\"kind\" = 'image' and \"entries\".\"slug\" ~ '^[a-z0-9]+(-[a-z0-9]+)*[.](png|jpg|jpeg|webp|avif|gif|svg)$')\n\t\t\t\tor (\"entries\".\"kind\" <> 'image' and \"entries\".\"slug\" ~ '^[a-z0-9]+(-[a-z0-9]+)*$')"
        },
        "entries_path_ends_in_slug": {
          "name": "entries_path_ends_in_slug",
          "value": "\"entries\".\"path\" = \"entries\".\"slug\" or right(\"entries\".\"path\", length(\"entries\".\"slug\") + 1) = '/' || \"entries\".\"slug\""
        },
        "entries_document_columns": {
          "name": "entries_document_columns",
          "value": "\"entries\".\"kind\" <> 'document' or (\"entries\".\"title\" is not null and \"entries\".\"title\" <> '' and \"entries\".\"status\" is not null)"
        },
        "entries_other_columns": {
          "name": "entries_other_columns",
          "value": "\"entries\".\"kind\" = 'document' or (\"entries\".\"title\" is null and \"entries\".\"body\" is null and \"entries\".\"status\" is null\n\t\t\t\tand \"entries\".\"published_at\" is null and \"entries\".\"attributes\" = '{}' and \"entries\".\"extras\" = '{}'\n\t\t\t\tand \"entries\".\"tags\" = '{}' and \"entries\".\"links\" = '{}')"
        },
        "entries_config": {
          "name": "entries_config",
          "value": "\"entries\".\"config\" is null or (\"entries\".\"kind\" <> 'image' and jsonb_typeof(\"entries\".\"config\") = 'object')"
        },
        "entries_file": {
          "name": "entries_file",
          "value": "(\"entries\".\"kind\" = 'image') = (\"entries\".\"file\" is not null) and (\"entries\".\"file\" is null or jsonb_typeof(\"entries\".\"file\") = 'object')"
        },
        "entries_json_shapes": {
          "name": "entries_json_shapes",
          "value": "jsonb_typeof(\"entries\".\"attributes\") = 'object' and jsonb_typeof(\"entries\".\"extras\") = 'object'\n\t\t\t\tand (\"entries\".\"body\" is null or jsonb_typeof(\"entries\".\"body\") = 'object')"
        },
        "entries_status": {
          "name": "entries_status",
          "value": "\"entries\".\"status\" in ('draft', 'published')"
        },
        "entries_published_has_date": {
          "name": "entries_published_has_date",
          "value": "(\"entries\".\"status\" = 'published') = (\"entries\".\"published_at\" is not null)"
        },
        "entries_published_at_ms": {
          "name": "entries_published_at_ms",
          "value": "\"entries\".\"published_at\" = date_trunc('milliseconds', \"entries\".\"published_at\")"
        },
        "entries_tags": {
          "name": "entries_tags",
          "value": "cardinality(\"entries\".\"tags\") <= 20 and array_position(\"entries\".\"tags\", null) is null\n\t\t\t\tand array_to_string(\"entries\".\"tags\", ',') ~ '^([a-z0-9]+(-[a-z0-9]+)*)?(,[a-z0-9]+(-[a-z0-9]+)*)*$'"
        }
      },
      "isRLSEnabled": false
    },
