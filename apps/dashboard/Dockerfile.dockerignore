# The build context is the whole workspace: leave out what the image doesn't need, and secrets.
# (BuildKit reads this file because it sits next to the Dockerfile.)
**/node_modules
**/.output
**/.next
**/.vinxi
**/.tanstack
**/.vercel
**/.turbo
**/dist
**/coverage
**/e2e/.artifacts
**/.env
**/.env.*
!**/.env.example
.git
.github
docs
**/*.log
**/.DS_Store
.vscode
.idea
.claude
.agents
