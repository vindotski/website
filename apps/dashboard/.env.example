# Copy to .env (gitignored). The values below work with the local stack (`pnpm db:start`; in the
# Spotcraft repository, `pnpm dev` writes this file for you).
# Variables prefixed with VITE_ are inlined into the browser bundle at build time; the rest are
# server-only.

# Any Postgres. Locally: the docker compose container. Hosted: your provider's connection string
# (Neon, Supabase, Railway, RDS, …); on serverless hosts use its pooled (transaction-mode) URL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/spotcraft

# Better Auth. The secret signs sessions: at least 32 random characters, e.g. `openssl rand -base64 32`.
# The URL is where this app is served; email links point there.
BETTER_AUTH_SECRET=change-me-to-32-or-more-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Outgoing email (invites, password resets). Locally: Mailpit (http://localhost:8025).
# Hosted: any SMTP provider, e.g. smtp://user:password@smtp.example.com:587
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=Spotcraft <noreply@localhost>

# Images: any S3-compatible bucket (AWS S3, Cloudflare R2, Supabase Storage, Backblaze B2, …), with
# path-style URLs. Locally: SeaweedFS from the local stack (no keys needed). Without S3_BUCKET and
# S3_ENDPOINT images are off. Objects stay private: Spotcraft serves them at /media.
S3_ENDPOINT=http://127.0.0.1:8333
S3_BUCKET=spotcraft
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local
# S3_REGION=auto

# Optional. /api/search searches by words without it; with a key, by meaning too. Then run
# `pnpm search:sync` once.
# OPENAI_API_KEY=sk-...
# Any OpenAI-compatible embeddings API (1536-dimension vectors).
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional. For your frontend's server (never a browser): drafts with `drafts=true`, and no search
# rate limit. At least 32 random characters, e.g. `openssl rand -base64 32`.
# SPOTCRAFT_API_TOKEN=

# Optional. Content changes are POSTed here, signed (X-Spotcraft-Signature) with the secret.
# WEBHOOK_URL=https://example.com/api/revalidate
# WEBHOOK_SECRET=

# Optional. The "Source code" link in the app (AGPL: a modified version used over a network offers
# its users the source). If you change Spotcraft, point it at your fork. Inlined at build time.
# VITE_SPOTCRAFT_SOURCE_URL=https://github.com/you/spotcraft

# Docker builds only. The build context is the pnpm workspace root, and the app's directory in it.
# The defaults fit a monorepo with the app in apps/dashboard; for a standalone copy, set both to ".".
# SPOTCRAFT_BUILD_CONTEXT=../..
# SPOTCRAFT_APP_DIR=apps/dashboard
