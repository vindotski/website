{
	"name": "dashboard",
	"version": "0.1.0",
	"description": "The Spotcraft app: the dashboard, accounts and the public API. Self-hosted, on your own Postgres.",
	"license": "AGPL-3.0-or-later",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"start": "node --env-file-if-exists=.env .output/server/index.mjs",
		"preview": "vite preview",
		"generate-routes": "tsr generate",
		"typecheck": "tsc --noEmit",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"format": "biome format --write",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "pnpm build && vitest run --config vitest.e2e.config.ts",
		"docker:prod": "docker compose -f docker-compose.prod.yml up -d --build",
		"db:start": "docker compose up -d --wait postgres mailpit s3",
		"db:stop": "docker compose down",
		"db:generate": "drizzle-kit generate",
		"db:check": "drizzle-kit check",
		"db:studio": "drizzle-kit studio",
		"db:migrate": "drizzle-kit migrate",
		"db:reset": "node --env-file-if-exists=.env scripts/db-reset.ts",
		"content:export": "node --env-file-if-exists=.env scripts/content-export.ts",
		"content:import": "node --env-file-if-exists=.env scripts/content-import.ts",
		"search:sync": "node --env-file-if-exists=.env scripts/search-sync.ts",
		"account:create": "node --env-file-if-exists=.env scripts/account-create.ts",
		"openapi": "node scripts/openapi.ts"
	},
	"dependencies": {
		"@codemirror/commands": "6.11.1",
		"@codemirror/lang-json": "6.0.2",
		"@codemirror/lang-markdown": "6.5.2",
		"@codemirror/lang-yaml": "6.1.3",
		"@codemirror/language": "6.13.1",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.15",
		"@fontsource-variable/geist": "^5.3.0",
		"@lezer/highlight": "1.2.5",
		"@orpc/openapi": "1.16.1",
		"@orpc/server": "1.16.1",
		"@orpc/zod": "1.16.1",
		"@t3-oss/env-core": "0.13.11",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-devtools": "0.10.14",
		"@tanstack/react-form": "1.33.5",
		"@tanstack/react-query": "5.105.0",
		"@tanstack/react-query-devtools": "5.105.0",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-router-devtools": "1.167.2",
		"@tanstack/react-router-ssr-query": "1.167.3",
		"@tanstack/react-start": "1.169.4",
		"@vercel/functions": "3.10.5",
		"aws4fetch": "1.0.20",
		"better-auth": "1.7.14",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cn": "^0.5.1",
		"drizzle-orm": "0.45.4",
		"github-slugger": "2.0.0",
		"image-size": "2.0.4",
		"lucide-react": "^0.577.0",
		"mdast-util-from-markdown": "2.1.0",
		"mdast-util-gfm": "3.1.0",
		"mdast-util-to-markdown": "2.2.1",
		"mdast-util-to-string": "4.0.0",
		"micromark-extension-gfm": "3.0.0",
		"next-themes": "^0.4.6",
		"nitro": "3.0.260610-beta",
		"nodemailer": "10.3.1",
		"pg": "8.23.1",
		"radix-ui": "^1.8.1",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-markdown": "10.1.0",
		"react-resizable-panels": "4.14.5",
		"recharts": "3.8.0",
		"remark-gfm": "4.0.1",
		"shadcn": "^4.23.0",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.0.2",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.3.6",
		"yaml": "2.9.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@tanstack/devtools-vite": "0.8.6",
		"@tanstack/intent": "^0.5.6",
		"@tanstack/router-cli": "^1.132.0",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/mdast": "4.0.4",
		"@types/node": "^22.10.2",
		"@types/nodemailer": "8.0.2",
		"@types/pg": "8.23.1",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"drizzle-kit": "0.31.11",
		"esbuild": "0.28.2",
		"fast-check": "4.10.2",
		"jsdom": "^30.1.3",
		"seroval": "1.7.5",
		"typescript": "^6.0.2",
		"vercel": "65.8.0",
		"vite": "^8.0.0",
		"vitest": "^5.0.5"
	},
	"engines": {
		"node": "26.x"
	},
	"intent": {
		"skills": [
			"@tanstack/react-start",
			"@tanstack/start-client-core",
			"@tanstack/start-server-core",
			"@tanstack/react-router",
			"@tanstack/router-core"
		],
		"exclude": [
			"@tanstack/react-router#lifecycle/*",
			"@tanstack/react-start#lifecycle/*",
			"@tanstack/react-start#react-start/server-components"
		]
	}
}
